GEMINI_API_KEY=paste-your-key-here

# Optional. YouTube blocks datacenter IPs, so a cloud-hosted app usually cannot fetch
# transcripts directly. Point these at a residential proxy (Webshare, Bright Data, ...)
# to re-enable the "YouTube URL" mode when deployed. Local runs do not need this.
# TRANSCRIPT_PROXY_HTTPS_URL=http://USER:PASS@PROXY-HOST:PORT
# TRANSCRIPT_PROXY_HTTP_URL=http://USER:PASS@PROXY-HOST:PORT
